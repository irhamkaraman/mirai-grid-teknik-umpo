# Application
APP_ENV=production
APP_SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-32chars
API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://76.76.76.189:3000

# Base Domain for student projects (if using domain, e.g., labit-umpo.net)
BASE_DOMAIN=76.76.76.189

# Encryption Key for sensitive database credentials stored at rest (32 bytes base64 encoded)
# Generate using: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEY=r3k1a9z7P0bQxW+V4sE9dF2gH1jK8lM5nO3pQ7rT6vU=

# Storage Paths
DATA_DIR=/app/data
UPLOADS_DIR=/app/data/uploads
PROJECTS_DIR=/app/data/projects

# Portainer Connection (Internal Docker / Localhost within labdocker)
PORTAINER_URL=https://portainer:9443
PORTAINER_API_KEY=ptr_change_this_to_actual_portainer_api_key
PORTAINER_ENDPOINT_ID=3
PORTAINER_SSL_VERIFY=false

# Centralized Database Engine (database-center stack)
# Used by MiraiGrid to provision student databases & user credentials
POSTGRES_ADMIN_HOST=db_postgres
POSTGRES_ADMIN_PORT=5432
POSTGRES_ADMIN_USER=root
POSTGRES_ADMIN_PASSWORD=splitti26password
POSTGRES_DEFAULT_DB=postgres

MARIADB_ADMIN_HOST=db_mariadb
MARIADB_ADMIN_PORT=3306
MARIADB_ADMIN_USER=root
MARIADB_ADMIN_PASSWORD=splitti26password

# Default Student Quotas
DEFAULT_MAX_PROJECTS=2
DEFAULT_MAX_DATABASES=2
DEFAULT_MAX_MEMORY_MB=256
DEFAULT_MAX_CPU_CORES=0.5
DEFAULT_MAX_DISK_MB=500
